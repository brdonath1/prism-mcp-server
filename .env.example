GITHUB_PAT=your-github-pat-placeholder
GITHUB_OWNER=brdonath1
FRAMEWORK_REPO=prism-framework
PORT=3000
LOG_LEVEL=info

# IP Allowlisting (enabled by default)
# Anthropic's 160.79.104.0/21 is always allowed when IP allowlisting is active.
# Add additional CIDR ranges (comma-separated) for personal/VPN access:
# ALLOWED_CIDRS=203.0.113.0/24,198.51.100.42/32
# To disable IP allowlisting entirely (e.g., local development):
# ENABLE_IP_ALLOWLIST=false

# Optional Bearer token auth (secondary to IP allowlist)
# MCP_AUTH_TOKEN=your-mcp-auth-token-placeholder

# Railway operations gateway (brief-103). When set, unlocks railway_logs,
# railway_deploy, railway_env, and railway_status tools. Workspace-scoped token.
# RAILWAY_API_TOKEN=your-railway-token-placeholder
# RAILWAY_WORKSPACE_ID=your-railway-workspace-id

# Claude Code OAuth token for cc_dispatch.
# Generate via `claude setup-token` on a Mac signed into the intended
# Claude Max subscription. Required to enable cc_dispatch + cc_status —
# when unset, those tools are not registered. Also selects the cc_subprocess
# synthesis transport when SYNTHESIS_*_TRANSPORT opts in.
# CLAUDE_CODE_OAUTH_TOKEN=your-claude-code-oauth-token-placeholder

# Anthropic API key — enables intelligence-brief / PDU / draft synthesis via the
# Messages API transport. When unset, synthesis is disabled unless a call site
# is routed to the cc_subprocess transport (which uses CLAUDE_CODE_OAUTH_TOKEN).
# ANTHROPIC_API_KEY=your-anthropic-api-key-placeholder

# Synthesis routing (production knobs — see docs/model-bump.md). Per-call-site
# model + transport are env-driven; unset falls back to the registry default
# (SYNTHESIS_MODEL_ID in src/models.ts) over the direct Messages API.
#
# INTENDED PRODUCTION CONFIG — direct-Anthropic synthesis path: Claude Haiku 4.5
# for the mechanical draft (CS-1), Claude Sonnet 5 for the judgment-heavy brief
# (CS-2) and PDU (CS-3), all over the direct Messages API transport. The
# messages_api transport applies Anthropic prompt caching to the stable
# living-doc/context bundle, so this is a SPEED config with no intended quality
# change — the existing per-site quality-gate fallback still protects output.
# SYNTHESIS_DRAFT_MODEL=claude-haiku-4-5
# SYNTHESIS_BRIEF_MODEL=claude-sonnet-5
# SYNTHESIS_PDU_MODEL=claude-sonnet-5
# SYNTHESIS_BRIEF_TRANSPORT=messages_api
# SYNTHESIS_DRAFT_TRANSPORT=messages_api
# SYNTHESIS_PDU_TRANSPORT=messages_api
# SYNTHESIS_BRIEF_THINKING=true
# SYNTHESIS_PDU_THINKING=true

# Claude Code dispatch model override (default: CC_DISPATCH_MODEL_ID in src/models.ts)
# CC_DISPATCH_MODEL=
# CC_DISPATCH_MAX_TURNS=50

# Multi-provider synthesis routing (disabled by default; live when enabled and
# dry-run is explicitly false). Provider keys are read only from env vars and
# never logged. cc_dispatch remains Claude Code OAuth execution.
# OPENAI_API_KEY=your-openai-key-placeholder
# GEMINI_API_KEY=your-gemini-key-placeholder
# DEEPSEEK_API_KEY=your-deepseek-key-placeholder
# CEREBRAS_API_KEY=your-cerebras-key-placeholder
# XAI_API_KEY=your-xai-key-placeholder
# PERPLEXITY_API_KEY=your-perplexity-key-placeholder
# LLM_ROUTING_ENABLED=false
# LLM_ROUTING_DRY_RUN=true
# LLM_ROUTING_X_SENTIMENT_ENABLED=false
# LLM_ROUTING_PROFILE=frontier-quality
# LLM_ROUTING_ALLOWED_PROVIDERS=anthropic
# LLM_ROUTING_DEFAULT_PROVIDER=anthropic
# For the direct-Anthropic synthesis path above, pin every synthesis call site
# to anthropic so brief/draft/pdu stay on Claude via the Messages API.
# LLM_ROUTING_SYNTHESIS_BRIEF_PROVIDER=anthropic
# LLM_ROUTING_SYNTHESIS_DRAFT_PROVIDER=anthropic
# LLM_ROUTING_SYNTHESIS_PDU_PROVIDER=anthropic
# LLM_ROUTING_CC_DISPATCH_PROVIDER=anthropic
# LLM_ROUTING_RECOMMENDATION_PROVIDER=anthropic
# LLM_ROUTING_OPENAI_MODEL=gpt-5.5
# LLM_ROUTING_GEMINI_MODEL=gemini-3.1-pro-preview
# LLM_ROUTING_DEEPSEEK_MODEL=deepseek-v4-pro
# S208: the three models the Cerebras account serves are zai-glm-4.7
# (registry default), gpt-oss-120b, and gemma-4-31b. Setting this var (or the
# key above) does NOT route anything: cerebras must also appear in
# LLM_ROUTING_ALLOWED_PROVIDERS and be named by a per-site provider var.
# LLM_ROUTING_CEREBRAS_MODEL=zai-glm-4.7
# LLM_ROUTING_XAI_MODEL=grok-4.3
# LLM_ROUTING_PERPLEXITY_MODEL=sonar-pro

# D-275 mechanical-tier synthesis routing (GLM-5.2 via OpenRouter). For the
# direct-Anthropic path above, LEAVE LLM_ROUTING_OPENROUTER_SITES UNSET/empty so
# the synthesis sites are EXCLUDED from OpenRouter and stay on Claude. GLM stays
# available as an instant kill-switch: set the sites below (with OPENROUTER_API_KEY,
# LLM_ROUTING_ENABLED=true, LLM_ROUTING_DRY_RUN=false) to shift those call sites
# back onto GLM-5.2 without a deploy; clearing the var reverts to direct-Anthropic.
# OPENROUTER_API_KEY=your-openrouter-key-placeholder
# LLM_ROUTING_OPENROUTER_MODEL=z-ai/glm-5.2
# LLM_ROUTING_OPENROUTER_SITES=synthesis_draft,synthesis_brief,synthesis_pdu

# NOTE: src/config.ts is the authoritative inventory of all ~40 env vars
# (timeouts, oversize/byte caps, etc.). This file lists the common ones.
